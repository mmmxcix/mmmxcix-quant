# Security headers for all routes (Cloudflare Pages applies these).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # The SPA serves index.html at EVERY route (/, /charts, /welcome, …), not just
  # /index.html — so the no-cache must live here or those routes cache a stale
  # index that points at deleted chunks ("Something went wrong"). The immutable
  # /assets/* rule below is more specific and still wins for hashed bundles.
  Cache-Control: no-cache, must-revalidate
  # 'unsafe-eval' is required because the backtest compiles user/AI strategy
  # code with new Function() (JS) and Pyodide's WASM (Python). Known tradeoff for
  # the single-user dev tool; before a public launch the eval moves to a
  # sandboxed Worker and this can be tightened. cdn.jsdelivr.net is scoped in for
  # the Pyodide runtime + numpy/pandas wheels (Python backtesting) — a reputable
  # CDN, loaded only when the user opts into Python mode. connect-src covers
  # Binance (crypto data) + self (proxied Yahoo, news, api) + jsdelivr (Pyodide
  # wheel fetches) + the local IBKR Client Portal Gateway (dev-only live quotes;
  # harmless for visitors — nothing listens on their localhost:5000 unless they
  # run the gateway themselves).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.binance.com wss://stream.binance.com:9443 wss://stream.aisstream.io https://earthquake.usgs.gov https://generativelanguage.googleapis.com https://cdn.jsdelivr.net https://localhost:5000 https://127.0.0.1:5000; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Hashed build assets are content-addressed: the filename changes whenever the
# bytes change, so they can be cached forever. (Pages' default was
# max-age=14400 + must-revalidate, which meant a *wrongly* cached response also
# stuck around for four hours — see public/_redirects for that incident.)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must NEVER be cached: it is the map from route → current chunk
# hashes. A stale copy points at chunks that no longer exist.
/index.html
  Cache-Control: no-cache, must-revalidate
