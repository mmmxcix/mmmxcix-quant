# Security headers for all routes (Cloudflare Pages applies these).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # 'unsafe-eval' is required because the backtest compiles user/AI strategy
  # code with new Function(). This is a known tradeoff for the single-user dev
  # tool; before a public launch the eval moves to a sandboxed Worker and this
  # can be tightened. connect-src covers Binance (crypto data) + self (proxied
  # Yahoo, news, api) + the local IBKR Client Portal Gateway (dev-only live
  # quotes; harmless for visitors — nothing listens on their localhost:5000
  # unless they run the gateway themselves).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.binance.com wss://stream.binance.com:9443 https://generativelanguage.googleapis.com https://localhost:5000 https://127.0.0.1:5000; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
